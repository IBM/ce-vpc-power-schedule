# IBM Cloud Configuration
# Copy this file to .env and fill in your values

# IBM Cloud API Key (required)
IBM_APIKEY=your-api-key-here

# IBM Cloud Region (required)
# Options: us-south, us-east, eu-de, eu-gb, jp-tok, jp-osa, au-syd, ca-tor, br-sao
IBM_REGION=us-south

# Path to configuration file (optional, defaults to /app/config/schedule.yaml in production)
CONFIG_PATH=./schedule_template.yaml

# Log Level (optional, defaults to Info)
# Options: Debug, Info, Warn, Error
LOG_LEVEL=Debug
